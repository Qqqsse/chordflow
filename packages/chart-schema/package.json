{
  "name": "@chordflow/chart-schema",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Canonical chordflow contracts: Zod schemas, TS types and generated JSON Schema.",
  "exports": {
    ".": "./src/index.ts",
    "./json-schema/*": "./json-schema/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate:json-schema": "tsx scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
