# Copy to `.env` for local Docker Compose use. Never commit `.env`.
# All values below are placeholders for a local, private installation.

# --- web ---
# Host port bound on 127.0.0.1 only. Use a reverse proxy for LAN/public access.
WEB_PORT=3000
# Public base URL as seen by browsers (used later for trusted-origin / cookie checks).
APP_BASE_URL=http://localhost:3000
# demo: fixture-only catalog, no database required. database: use DATABASE_URL.
CHORDFLOW_DATA_MODE=demo

# --- accounts (database mode only) ---
# Required in database mode, at least 32 characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Only set to true behind a reverse proxy that overwrites X-Forwarded-For (rate limiting by client IP).
TRUST_PROXY=false

# --- PostgreSQL ---
POSTGRES_USER=chordflow
POSTGRES_DB=chordflow
# Required. Generate one, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=replace-with-a-generated-password
# Used by the web container; host `db` is the Compose service name.
DATABASE_URL=postgres://chordflow:replace-with-a-generated-password@db:5432/chordflow

# --- AI worker (Compose profile `worker`) ---
WORKER_API_BASE_URL=http://web:3000
# Required for the worker profile. Dedicated service credential, at least 16 chars.
WORKER_TOKEN=replace-with-a-generated-worker-token
WORKER_PROCESSOR_MODE=mock

# --- optional LLM review (disabled by default; never enabled implicitly) ---
LLM_PROVIDER=disabled
# VERTEX_PROJECT_ID=
# GCP_LOCATION=
