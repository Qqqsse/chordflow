# Copy to `.env` for local Docker Compose use. Never commit `.env`.
# All values below are placeholders for a local, private installation.

# --- web ---
# Host port bound on 127.0.0.1 only. Use a reverse proxy for LAN/public access.
WEB_PORT=3000
# Public base URL as seen by browsers (used later for trusted-origin / cookie checks).
APP_BASE_URL=http://localhost:3000
# demo: fixture-only catalog, no database required. database: use DATABASE_URL.
CHORDFLOW_DATA_MODE=demo

# --- accounts (database mode only) ---
# Required in database mode, at least 32 characters, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Only set to true behind a reverse proxy that overwrites X-Forwarded-For (rate limiting by client IP).
TRUST_PROXY=false
# Password sign-in attempts per minute per client (brute-force guard). Default 10.
# AUTH_SIGN_IN_PER_MINUTE=10

# --- audio uploads (database mode; docs/audio-sources.md) ---
# Private directory for uploaded audio (absolute path, never served). Compose mounts the
# `audio-uploads` volume here; uploads stay disabled when this is empty.
AUDIO_UPLOAD_DIR=/var/lib/chordflow/audio-uploads
# Who may upload: admin (default) or admin,member.
AUDIO_UPLOAD_ROLES=admin
# Optional limits; defaults: 50 MB per file, 15 minutes, 1 GB per account, kept 30 days after last use.
# AUDIO_UPLOAD_MAX_BYTES=52428800
# AUDIO_MAX_DURATION_SECONDS=900
# AUDIO_USER_QUOTA_BYTES=1073741824
# AUDIO_RETENTION_DAYS=30
# Optional contact shown on the terms page (takedown requests).
# SITE_CONTACT=

# --- PostgreSQL ---
POSTGRES_USER=chordflow
POSTGRES_DB=chordflow
# Required. Generate one, e.g. `openssl rand -base64 32`.
POSTGRES_PASSWORD=replace-with-a-generated-password
# Used by the web container; host `db` is the Compose service name.
DATABASE_URL=postgres://chordflow:replace-with-a-generated-password@db:5432/chordflow

# --- AI worker (Compose profile `worker`) ---
WORKER_API_BASE_URL=http://web:3000
# Shared by web (verifies) and worker (sends). Dedicated service credential, at least 32
# characters, e.g. `openssl rand -base64 48`. The worker API stays disabled (503) until set.
WORKER_TOKEN=
# During rotation set the old token here, restart web, then switch the worker to the new one.
WORKER_TOKEN_PREVIOUS=
WORKER_PROCESSOR_MODE=mock
WORKER_ID=cpu-mock-1
# Per-job cap on reviewer calls (only the fake reviewer exists; it never costs money).
WORKER_LLM_MAX_CALLS=4

# --- optional LLM review (disabled by default; never enabled implicitly) ---
LLM_PROVIDER=disabled
# VERTEX_PROJECT_ID=
# GCP_LOCATION=
